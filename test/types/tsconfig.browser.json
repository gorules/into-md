{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": [
      "browser"
    ],
    "lib": [
      "es2022",
      "dom"
    ],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  "files": [
    "browser.ts"
  ]
}
