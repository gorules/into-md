{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "package-name": "@gorules/into-md",
      "release-type": "node",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/into-md/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value === 'into-md')].version"
        }
      ]
    }
  }
}
